{
  "name": "dsh-session-manager",
  "version": "0.1.0",
  "description": "Session management for DeepSeek Harness Web: category/tag/status/priority annotations with a board panel (grouping, filters, Eisenhower quadrants).",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-host.mjs",
    "build:client": "tsdown",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session-manager",
    "board"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "^0.1.7-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-query": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.1.7-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
